<?xml version="1.0"?>
<launch>
    <arg name="world_name" default="$(find gazebo_sim_scout)/worlds/weston_robot_empty.world"/>
    <arg name="gui" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="rviz_config" default="$(find scout_description)/rviz/two_ugv_navigation.rviz"/>
    <arg name="paused" default="false"/>
    <arg name="enable_vrpn_server" default="false"/>
    <arg name="wheel_contact_mu2" default="0.35"/>
    <arg name="wheel_contact_slip2" default="0.1"/>
    <arg name="wheel_pid_p" default="80.0"/>
    <arg name="wheel_pid_i" default="0.0"/>
    <arg name="wheel_pid_d" default="0.0"/>
    <arg name="wheel_separation" default="0.416503"/>
    <arg name="wheel_radius" default="0.08"/>
    <arg name="command_gain" default="1.0"/>

    <arg name="ugv1_namespace" default="ugv1"/>
    <arg name="ugv1_model_name" default="$(arg ugv1_namespace)"/>
    <arg name="ugv1_x" default="0.0"/>
    <arg name="ugv1_y" default="0.6"/>
    <arg name="ugv1_z" default="0.181"/>
    <arg name="ugv1_yaw" default="0.0"/>

    <arg name="ugv2_namespace" default="ugv2"/>
    <arg name="ugv2_model_name" default="$(arg ugv2_namespace)"/>
    <arg name="ugv2_x" default="0.0"/>
    <arg name="ugv2_y" default="-0.6"/>
    <arg name="ugv2_z" default="0.181"/>
    <arg name="ugv2_yaw" default="0.0"/>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch">
        <arg name="robot_namespace" value="$(arg ugv1_namespace)" />
        <arg name="model_name" value="$(arg ugv1_model_name)" />
        <arg name="x" value="$(arg ugv1_x)" />
        <arg name="y" value="$(arg ugv1_y)" />
        <arg name="z" value="$(arg ugv1_z)" />
        <arg name="yaw" value="$(arg ugv1_yaw)" />
        <arg name="robot_description_param" value="/$(arg ugv1_namespace)/robot_description" />
        <arg name="odom_topic" value="/$(arg ugv1_namespace)/odom" />
        <arg name="odom_frame" value="odom" />
        <arg name="base_frame" value="$(arg ugv1_namespace)/base_link" />
        <arg name="tf_prefix" value="$(arg ugv1_namespace)" />
        <arg name="frame_prefix" value="$(arg ugv1_namespace)/" />
        <arg name="sensor_namespace" value="$(arg ugv1_namespace)" />
        <arg name="robot_state_publisher_namespace" value="$(arg ugv1_namespace)" />
        <arg name="wheel_contact_mu2" value="$(arg wheel_contact_mu2)" />
        <arg name="wheel_contact_slip2" value="$(arg wheel_contact_slip2)" />
        <arg name="wheel_pid_p" value="$(arg wheel_pid_p)" />
        <arg name="wheel_pid_i" value="$(arg wheel_pid_i)" />
        <arg name="wheel_pid_d" value="$(arg wheel_pid_d)" />
        <arg name="wheel_separation" value="$(arg wheel_separation)" />
        <arg name="wheel_radius" value="$(arg wheel_radius)" />
        <arg name="command_gain" value="$(arg command_gain)" />
    </include>

    <include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch">
        <arg name="robot_namespace" value="$(arg ugv2_namespace)" />
        <arg name="model_name" value="$(arg ugv2_model_name)" />
        <arg name="x" value="$(arg ugv2_x)" />
        <arg name="y" value="$(arg ugv2_y)" />
        <arg name="z" value="$(arg ugv2_z)" />
        <arg name="yaw" value="$(arg ugv2_yaw)" />
        <arg name="robot_description_param" value="/$(arg ugv2_namespace)/robot_description" />
        <arg name="odom_topic" value="/$(arg ugv2_namespace)/odom" />
        <arg name="odom_frame" value="odom" />
        <arg name="base_frame" value="$(arg ugv2_namespace)/base_link" />
        <arg name="tf_prefix" value="$(arg ugv2_namespace)" />
        <arg name="frame_prefix" value="$(arg ugv2_namespace)/" />
        <arg name="sensor_namespace" value="$(arg ugv2_namespace)" />
        <arg name="robot_state_publisher_namespace" value="$(arg ugv2_namespace)" />
        <arg name="wheel_contact_mu2" value="$(arg wheel_contact_mu2)" />
        <arg name="wheel_contact_slip2" value="$(arg wheel_contact_slip2)" />
        <arg name="wheel_pid_p" value="$(arg wheel_pid_p)" />
        <arg name="wheel_pid_i" value="$(arg wheel_pid_i)" />
        <arg name="wheel_pid_d" value="$(arg wheel_pid_d)" />
        <arg name="wheel_separation" value="$(arg wheel_separation)" />
        <arg name="wheel_radius" value="$(arg wheel_radius)" />
        <arg name="command_gain" value="$(arg command_gain)" />
    </include>

    <include if="$(arg enable_vrpn_server)" file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_server.launch">
        <arg name="auto_track_known_models" value="true"/>
    </include>

    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" />
</launch>
