<launch>
  <arg name="world_name"/>
  <arg name="simulation_service_ref_json"/>
  <arg name="target_id"/>
<include file="$(find gazebo_sim_worlds)/launch/native_world.launch">
      <arg name="world" value="$(arg world_name)"/>
      <arg name="paused" value="true"/>
      <arg name="gui" value="false"/>
      <arg name="ros_data" value="true"/>
    </include>
<include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch"><arg name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><arg name="target_id" value="$(arg target_id)"/><arg name="ns" value="scout1"/><arg name="robot_state_publisher_ns" value="/scout1"/><arg name="robot_description_param" value="/scout1/robot_description"/><arg name="y" value="0"/></include>
<include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch"><arg name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><arg name="target_id" value="$(arg target_id)"/><arg name="ns" value="scout2"/><arg name="robot_state_publisher_ns" value="/scout2"/><arg name="robot_description_param" value="/scout2/robot_description"/><arg name="y" value="3"/></include>
<include file="$(find gazebo_sim_mecanum)/launch/spawn.launch"><arg name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><arg name="target_id" value="$(arg target_id)"/><arg name="ns" value="mecanum1"/><arg name="y" value="6"/></include>
<test test-name="scout_runtime" pkg="gazebo_sim_scout" type="scout_runtime.py" time-limit="100"><param name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><param name="target_id" value="$(arg target_id)"/></test>
</launch>