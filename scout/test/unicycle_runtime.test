<launch>
  <arg name="world_name"/>
  <arg name="simulation_service_ref_json"/>
  <arg name="target_id"/>
  <!-- Run only in an isolated test container. Never attach to a live station. -->
  <include file="$(find gazebo_sim_worlds)/launch/native_world.launch">
      <arg name="world" value="$(arg world_name)"/>
      <arg name="paused" value="false"/>
      <arg name="gui" value="false"/>
      <arg name="ros_data" value="true"/>
    </include>
  <include file="$(find gazebo_sim_scout)/launch/spawn_accurate.launch"><arg name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><arg name="target_id" value="$(arg target_id)"/>
    <arg name="ns" value="unicycle_test"/>
    <arg name="model_name" value="unicycle_test"/>
    <arg name="dynamics_mode" value="unicycle"/>
    <arg name="robot_description_param" value="/unicycle_test/robot_description"/>
    <arg name="publish_scout_status" value="false"/>
    <arg name="robot_state_publisher_ns" value="unicycle_test"/>
    <arg name="frame_prefix" value="unicycle_test/"/>
  </include>
  <test test-name="scout_unicycle_runtime" pkg="gazebo_sim_scout"
        type="test_unicycle_runtime.py" time-limit="90"><param name="simulation_service_ref_json" value="$(arg simulation_service_ref_json)"/><param name="target_id" value="$(arg target_id)"/></test>
</launch>
