<?xml version="1.0"?>
<launch>
  <arg name="ns" default="ugv1"/>
  <arg name="world_name" default="$(find gazebo_sim_worlds)/worlds/ugv4_figure_eight_scout_obstacles/ugv4_figure_eight_scout_obstacles.world"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>

  <include file="$(find gazebo_sim_scout)/launch/accurate.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="enable_rslidar" value="true"/>
  </include>

  <node name="rslidar_points_pc2" pkg="gazebo_sim_scout" type="pointcloud_to_pointcloud2" output="screen">
    <remap from="~in" to="/rslidar_points_raw"/>
    <remap from="~out" to="/rslidar_points"/>
  </node>
</launch>
