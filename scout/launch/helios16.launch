<?xml version="1.0"?>
<launch>
  <arg name="ns" default="ugv1"/>
  <arg name="world_name" default="$(find gazebo_sim_worlds)/worlds/corridor_static/corridor_static.world"/>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="wheel_contact_mu2" default="0.45"/>
  <arg name="wheel_contact_slip2" default="0.25"/>
  <arg name="angular_command_gain" default="2.50"/>
  <!-- false: LIO owns camera_init->body->base_link. Gazebo still publishes /odom. -->
  <arg name="publish_tf" default="false"/>

  <!-- Use the sibling launch so an older installed gazebo_sim_scout package
       cannot silently win duplicate-package resolution. -->
  <include file="$(dirname)/accurate.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="enable_rslidar" value="true"/>
    <arg name="publish_tf" value="$(arg publish_tf)"/>
    <arg name="wheel_contact_mu2" value="$(arg wheel_contact_mu2)"/>
    <arg name="wheel_contact_slip2" value="$(arg wheel_contact_slip2)"/>
    <arg name="angular_command_gain" value="$(arg angular_command_gain)"/>
  </include>

  <node name="rslidar_points_pc2" pkg="gazebo_sim_scout" type="pointcloud_to_pointcloud2" output="screen">
    <remap from="~in" to="/rslidar_points_raw"/>
    <remap from="~out" to="/rslidar_points"/>
  </node>
</launch>
