<?xml version="1.0"?>
<launch>
    <arg name="ns" default="/"/>
    <arg name="urdf_extras" default="$(dirname)/../urdf/empty.urdf"/>
    <arg name="enable_ros_control" default="false"/>
    <arg name="robot_description_param" default="robot_description"/>
    <arg name="frame_prefix" default=""/>
    <arg name="sensor_ns" default="/"/>
    <arg name="enable_lidar" default="false"/>
    <arg name="enable_rslidar" default="false"/>
    <arg name="enable_camera" default="false"/>
    <arg name="wheel_contact_mu1" default="0.16"/>
    <arg name="wheel_contact_mu2" default="1.0"/>
    <arg name="wheel_contact_fdir1" default="0 0 1"/>
    <arg name="wheel_contact_slip1" default="0.0"/>
    <arg name="wheel_contact_slip2" default="0.0"/>
    <arg name="wheelbase" default="0.451"/>
    <arg name="wheel_track" default="0.416503"/>

    <arg name="wheel_radius" default="0.08"/>
    <arg name="wheel_mass" default="3.0"/>
    <arg name="wheel_width" default="0.084"/>
    <arg name="wheel_joint_damping" default="0.1"/>
    <arg name="wheel_inertial_axial_offset" default="0.0"/>
    <arg name="wheel_effort_limit" default="6.0"/>
    <arg name="wheel_velocity_limit" default="26.0"/>

    <param name="$(arg robot_description_param)" command="$(find xacro)/xacro '$(dirname)/../urdf/mini.xacro'
        ns:=$(arg ns)
        enable_ros_control:=$(arg enable_ros_control)
        robot_description_param:=$(arg robot_description_param)
        frame_prefix:=$(arg frame_prefix)
        sensor_ns:=$(arg sensor_ns)
        enable_lidar:=$(arg enable_lidar)
        enable_rslidar:=$(arg enable_rslidar)
        enable_camera:=$(arg enable_camera)
        wheel_contact_mu2:=$(arg wheel_contact_mu2)
        wheel_contact_mu1:=$(arg wheel_contact_mu1)
        wheel_contact_fdir1:='$(arg wheel_contact_fdir1)'
        wheel_contact_slip1:=$(arg wheel_contact_slip1)
        wheel_contact_slip2:=$(arg wheel_contact_slip2)
        wheelbase:=$(arg wheelbase)
        wheel_track:=$(arg wheel_track)
        wheel_radius:=$(arg wheel_radius)
        wheel_mass:=$(arg wheel_mass)
        wheel_width:=$(arg wheel_width)
        wheel_joint_damping:=$(arg wheel_joint_damping)
        wheel_inertial_axial_offset:=$(arg wheel_inertial_axial_offset)
        wheel_effort_limit:=$(arg wheel_effort_limit)
        wheel_velocity_limit:=$(arg wheel_velocity_limit)
        urdf_extras:=$(arg urdf_extras)" />
</launch>
