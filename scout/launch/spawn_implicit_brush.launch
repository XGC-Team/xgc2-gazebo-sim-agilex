<?xml version="1.0"?>
<launch>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.181"/>
  <arg name="yaw" default="0.0"/>
  <arg name="ns" default="ugv1"/>
  <arg name="model_name" default="$(arg ns)"/>
  <arg name="robot_description_param" default="robot_description"/>
  <arg name="pose_topic" default="/$(arg ns)/simulation/ground_truth/pose"/>
  <arg name="twist_topic" default="/$(arg ns)/simulation/ground_truth/twist"/>
  <arg name="world_frame" default="world"/>
  <arg name="tf_prefix" default=""/>
  <arg name="frame_prefix" default=""/>
  <arg name="sensor_ns" default="/"/>
  <arg name="enable_lidar" default="false"/>
  <arg name="enable_rslidar" default="false"/>
  <arg name="enable_camera" default="false"/>
  <arg name="robot_state_publisher_ns" default="/"/>
  <arg name="run_mode" default="simulation"/>
  <arg name="wheel_pid_p" default="1.8"/>
  <arg name="wheel_pid_i" default="10.0"/>
  <arg name="wheelbase" default="0.451"/>
  <arg name="wheel_track" default="0.416503"/>
  <arg name="wheel_radius" default="0.08"/>
  <arg name="wheel_mass" default="3.0"/>
  <arg name="wheel_width" default="0.084"/>
  <arg name="wheel_inertial_axial_offset" default="0.0"/>
  <arg name="wheel_effort_limit" default="6.0"/>
  <arg name="wheel_velocity_limit" default="26.0"/>
  <arg name="command_delay_s" default="0.005"/>
  <arg name="max_linear_speed" default="1.5"/>
  <arg name="max_angular_speed" default="1.0"/>
  <arg name="publish_scout_status" default="true"/>
  <arg name="status_topic" default="/$(arg ns)/scout_status"/>
  <arg name="light_control_topic" default="/$(arg ns)/scout_light_control"/>
  <arg name="battery_voltage" default="28.765"/>
  <arg name="brush_stiffness_n_m" default="12000.0"/>
  <arg name="brush_friction" default="0.6"/>
  <arg name="brush_renewal_length_m" default="0.04"/>
  <arg name="brush_allocation_gain" default="1.0"/>
  <arg name="brush_yaw_calibration" default="1.0"/>
  <arg name="brush_passive_drag_nm_s" default="0.0"/>
  <!-- Four actual wheels and normal contacts; no ros_control or allocator node. -->
  <include file="$(dirname)/mini_description.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="robot_description_param" value="$(arg robot_description_param)"/>
    <arg name="frame_prefix" value="$(arg frame_prefix)"/>
    <arg name="sensor_ns" value="$(arg sensor_ns)"/>
    <arg name="enable_lidar" value="$(arg enable_lidar)"/>
    <arg name="enable_rslidar" value="$(arg enable_rslidar)"/>
    <arg name="enable_camera" value="$(arg enable_camera)"/>
    <arg name="wheelbase" value="$(arg wheelbase)"/>
    <arg name="wheel_track" value="$(arg wheel_track)"/>
    <arg name="wheel_radius" value="$(arg wheel_radius)"/>
    <arg name="wheel_mass" value="$(arg wheel_mass)"/>
    <arg name="wheel_width" value="$(arg wheel_width)"/>
    <arg name="wheel_inertial_axial_offset" value="$(arg wheel_inertial_axial_offset)"/>
    <arg name="wheel_effort_limit" value="$(arg wheel_effort_limit)"/>
    <arg name="wheel_velocity_limit" value="$(arg wheel_velocity_limit)"/>
    <arg name="enable_ros_control" value="false"/>
    <arg name="urdf_extras" value="$(dirname)/../urdf/scout_implicit_wheel.xacro"/>
    <arg name="wheel_contact_mu1" value="0.0"/>
    <arg name="wheel_contact_mu2" value="0.0"/>
    <arg name="wheel_contact_slip1" value="0.0"/>
    <arg name="wheel_contact_slip2" value="0.0"/>
    <arg name="wheel_joint_damping" value="0.0"/>
  </include>
  <group ns="$(arg ns)/implicit_wheel">
    <param name="stiffness_n_m" type="double" value="$(arg brush_stiffness_n_m)"/>
    <param name="friction" type="double" value="$(arg brush_friction)"/>
    <param name="renewal_length_m" type="double" value="$(arg brush_renewal_length_m)"/>
    <param name="allocation_gain" type="double" value="$(arg brush_allocation_gain)"/>
    <param name="yaw_calibration" type="double" value="$(arg brush_yaw_calibration)"/>
    <param name="passive_drag_nm_s" type="double" value="$(arg brush_passive_drag_nm_s)"/>
    <param name="motor_p" type="double" value="$(arg wheel_pid_p)"/>
    <param name="motor_i" type="double" value="$(arg wheel_pid_i)"/>
    <param name="effort_limit_nm" type="double" value="$(arg wheel_effort_limit)"/>
    <param name="wheel_velocity_limit" type="double" value="$(arg wheel_velocity_limit)"/>
    <param name="command_delay_s" type="double" value="$(arg command_delay_s)"/>
    <param name="max_linear_speed" type="double" value="$(arg max_linear_speed)"/>
    <param name="max_angular_speed" type="double" value="$(arg max_angular_speed)"/>
  </group>
  <group ns="$(arg ns)">
    <param name="simulation/dynamics_mode" value="wheel_physics"/>
    <param name="simulation/wheel_physics_backend" value="implicit_brush"/>
  </group>
  <node name="$(arg ns)_spawn_scout_model" pkg="gazebo_ros" type="spawn_model"
        args="-x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw) -urdf -param $(arg robot_description_param) -model $(arg model_name)"/>
  <node name="$(arg ns)_gazebo_model_ground_truth" pkg="gazebo_sim_scout" type="gazebo_model_ground_truth" output="screen">
    <param name="model_name" value="$(arg model_name)"/>
    <param name="pose_topic" value="$(arg pose_topic)"/>
    <param name="twist_topic" value="$(arg twist_topic)"/>
    <param name="world_frame" value="$(arg world_frame)"/>
  </node>
  <node if="$(arg publish_scout_status)" name="$(arg ns)_sim_scout_status" pkg="gazebo_sim_scout" type="sim_scout_status" output="screen">
    <param name="joint_states_topic" value="/$(arg ns)/joint_states"/>
    <param name="status_topic" value="$(arg status_topic)"/>
    <param name="light_control_topic" value="$(arg light_control_topic)"/>
    <param name="battery_voltage" type="double" value="$(arg battery_voltage)"/>
    <param name="battery_publish_rate" type="double" value="0.5"/>
    <param name="chassis_publish_rate" type="double" value="1.0"/>
    <param name="control_mode" type="int" value="1"/>
    <param name="wheel_radius" type="double" value="$(arg wheel_radius)"/>
    <param name="wheel_track" type="double" value="$(arg wheel_track)"/>
  </node>
  <include file="$(dirname)/source_robot_state_publisher.launch">
    <arg name="ns" value="$(arg ns)"/>
    <arg name="robot_state_publisher_ns" value="$(arg robot_state_publisher_ns)"/>
    <arg name="tf_prefix" value="$(arg tf_prefix)"/>
    <arg name="frame_prefix" value="$(arg frame_prefix)"/>
    <arg name="run_mode" value="$(arg run_mode)"/>
  </include>
</launch>
