<?xml version="1.0"?>
<launch>
    <arg name="ns" default="ugv1"/>
    <arg name="world_name" default="$(find gazebo_sim_worlds)/worlds/empty/empty.world"/>
    <arg name="model_name" default="$(arg ns)"/>
    <arg name="gui" default="true"/>
    <arg name="rviz" default="true"/>
    <arg name="paused" default="false"/>
    <arg name="enable_vrpn_server" default="false"/>
    <arg name="enable_lidar" default="false"/>
    <arg name="enable_rslidar" default="false"/>
    <arg name="enable_camera" default="false"/>
    <arg name="wheel_contact_mu1" default="0.16"/>
    <arg name="wheel_contact_mu2" default="1.0"/>
    <arg name="wheel_contact_fdir1" default="0 0 1"/>
    <arg name="wheel_contact_slip1" default="0.0"/>
    <arg name="wheel_contact_slip2" default="0.0"/>
    <arg name="wheel_pid_p" default="1.8"/>
    <arg name="wheel_pid_i" default="10.0"/>
    <arg name="wheelbase" default="0.451"/>
    <arg name="wheel_track" default="0.416503"/>
    <arg name="wheel_separation" default="$(arg wheel_track)"/>
    <arg name="wheel_radius" default="0.08"/>
    <arg name="wheel_mass" default="3.0"/>
    <arg name="wheel_width" default="0.084"/>
    <arg name="wheel_joint_damping" default="0.1"/>
    <arg name="wheel_inertial_axial_offset" default="0.0"/>
    <arg name="wheel_effort_limit" default="6.0"/>
    <arg name="wheel_velocity_limit" default="26.0"/>
    <arg name="command_gain" default="1.01"/>
    <arg name="angular_command_gain" default="1.46"/>
    <arg name="command_delay_s" default="0.005"/>
    <arg name="enable_command_limits" default="true"/>
    <arg name="max_linear_speed" default="1.5"/>
    <arg name="max_angular_speed" default="1.0"/>
    <arg name="publish_scout_status" default="true"/>
    <arg name="status_topic" default="/$(arg ns)/scout_status"/>
    <arg name="light_control_topic" default="/$(arg ns)/scout_light_control"/>
    <arg name="battery_voltage" default="28.765"/>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="headless" value="false"/>
        <arg name="debug" value="false"/>
    </include>

    <include file="$(dirname)/spawn_accurate.launch">
        <arg name="ns" value="$(arg ns)" />
        <arg name="model_name" value="$(arg model_name)" />
        <arg name="enable_lidar" value="$(arg enable_lidar)" />
        <arg name="enable_rslidar" value="$(arg enable_rslidar)" />
        <arg name="enable_camera" value="$(arg enable_camera)" />
        <arg name="wheel_contact_mu1" value="$(arg wheel_contact_mu1)" />
        <arg name="wheel_contact_mu2" value="$(arg wheel_contact_mu2)" />
        <arg name="wheel_contact_fdir1" value="$(arg wheel_contact_fdir1)" />
        <arg name="wheel_contact_slip1" value="$(arg wheel_contact_slip1)" />
        <arg name="wheel_contact_slip2" value="$(arg wheel_contact_slip2)" />
        <arg name="wheel_pid_p" value="$(arg wheel_pid_p)" />
        <arg name="wheel_pid_i" value="$(arg wheel_pid_i)" />
        <arg name="wheelbase" value="$(arg wheelbase)" />
        <arg name="wheel_track" value="$(arg wheel_track)" />
        <arg name="wheel_mass" value="$(arg wheel_mass)" />
        <arg name="wheel_width" value="$(arg wheel_width)" />
        <arg name="wheel_joint_damping" value="$(arg wheel_joint_damping)" />
        <arg name="wheel_inertial_axial_offset" value="$(arg wheel_inertial_axial_offset)" />
        <arg name="wheel_separation" value="$(arg wheel_separation)" />
        <arg name="wheel_radius" value="$(arg wheel_radius)" />
        <arg name="wheel_effort_limit" value="$(arg wheel_effort_limit)" />
        <arg name="wheel_velocity_limit" value="$(arg wheel_velocity_limit)" />
        <arg name="command_gain" value="$(arg command_gain)" />
        <arg name="angular_command_gain" value="$(arg angular_command_gain)" />
        <arg name="command_delay_s" value="$(arg command_delay_s)" />
        <arg name="enable_command_limits" value="$(arg enable_command_limits)" />
        <arg name="max_linear_speed" value="$(arg max_linear_speed)" />
        <arg name="max_angular_speed" value="$(arg max_angular_speed)" />
        <arg name="publish_scout_status" value="$(arg publish_scout_status)" />
        <arg name="status_topic" value="$(arg status_topic)" />
        <arg name="light_control_topic" value="$(arg light_control_topic)" />
        <arg name="battery_voltage" value="$(arg battery_voltage)" />
    </include>

    <include if="$(arg enable_vrpn_server)" file="$(find gazebo_sim_vrpn_bridge)/launch/vrpn_server.launch">
        <arg name="auto_track_known_models" value="true"/>
    </include>

    <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz" args="-d $(find gazebo_sim_scout)/rviz/navigation.rviz" />
</launch>
