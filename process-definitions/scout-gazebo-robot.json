{
  "apiVersion": "xgc.execution.process/v1",
  "definitions": [
    {
      "id": "scout-gazebo-robot",
      "version": "4.1.0",
      "label": "Scout Mini Gazebo robot",
      "description": "Namespaced Scout Mini with spawn-time wheel_physics or delayed first-order unicycle dynamics; both modes use the same installed package.",
      "parameters": {
        "groups": [
          {
            "id": "dynamics",
            "label": "Simulation Dynamics",
            "collapsed": false,
            "parameters": [
              "dynamicsMode",
              "commandDelaySeconds",
              "unicycleLinearTimeConstantSeconds",
              "unicycleAngularTimeConstantSeconds"
            ]
          },
          {
            "id": "ros-advanced",
            "label": "ROS Advanced",
            "collapsed": true,
            "parameters": [
              "rosMasterUri",
              "rosIp"
            ]
          },
          {
            "id": "runtime-advanced",
            "label": "Runtime Advanced",
            "collapsed": true,
            "parameters": [
              "gazeboMasterUri"
            ]
          },
          {
            "id": "limits-advanced",
            "label": "Limits Advanced",
            "collapsed": true,
            "parameters": [
              "maxLinearSpeed",
              "maxAngularSpeed"
            ]
          },
          {
            "id": "geometry-advanced",
            "label": "Geometry Advanced",
            "collapsed": true,
            "parameters": [
              "wheelRadius",
              "wheelTrack",
              "wheelbase"
            ]
          },
          {
            "id": "contact-control-advanced",
            "label": "Contact and Control Advanced",
            "collapsed": true,
            "parameters": [
              "wheelContactFdir1",
              "wheelContactMu1",
              "wheelContactSlip1",
              "wheelContactMu2",
              "wheelContactSlip2",
              "wheelPidP",
              "wheelPidI",
              "wheelVelocityLimit",
              "wheelEffortLimit",
              "commandGain",
              "angularCommandGain",
              "wheelDiagnostics"
            ]
          }
        ],
        "properties": {
          "gazeboMasterUri": {
            "type": "string",
            "description": "Absolute URI of the existing shared Gazebo server",
            "default": "http://127.0.0.1:11345"
          },
          "maxAngularSpeed": {
            "type": "number",
            "description": "Maximum angular command in radians per second",
            "default": 0.5235,
            "minimum": 0.01
          },
          "maxLinearSpeed": {
            "type": "number",
            "description": "Maximum linear command in meters per second",
            "default": 1.5,
            "minimum": 0.01
          },
          "namespace": {
            "type": "string",
            "description": "Absolute frozen per-robot ROS namespace",
            "default": "/ugv1"
          },
          "rosMasterUri": {
            "type": "string",
            "description": "Absolute URI of the existing ROS master",
            "default": "http://127.0.0.1:11311",
            "output": true
          },
          "rosIp": {
            "type": "string",
            "description": "Reachable IPv4 address advertised by this robot process",
            "default": "127.0.0.1",
            "output": true
          },
          "wheelContactFdir1": {
            "type": "string",
            "description": "Wheel-local primary friction direction; keep parallel to the wheel axle",
            "default": "0 0 1"
          },
          "wheelContactMu1": {
            "type": "number",
            "description": "Lateral wheel contact friction along wheel-local fdir1",
            "default": 0.16,
            "minimum": 0
          },
          "wheelContactSlip1": {
            "type": "number",
            "description": "Wheel-physics lateral force-dependent slip (m/s/N), not an input time constant",
            "default": 0,
            "minimum": 0
          },
          "wheelContactMu2": {
            "type": "number",
            "description": "Longitudinal wheel contact friction perpendicular to wheel-local fdir1",
            "default": 1,
            "minimum": 0
          },
          "wheelContactSlip2": {
            "type": "number",
            "description": "Wheel-physics longitudinal force-dependent slip (m/s/N), not an input time constant",
            "default": 0,
            "minimum": 0
          },
          "wheelEffortLimit": {
            "type": "number",
            "description": "Simulation wheel effort limit in N m",
            "default": 6.0,
            "minimum": 1e-06
          },
          "wheelVelocityLimit": {
            "type": "number",
            "description": "Simulation wheel velocity limit in rad/s",
            "default": 26.0,
            "minimum": 1e-06
          },
          "wheelPidI": {
            "type": "number",
            "description": "Wheel-physics I-P integral gain on wheel speed error (N m/rad); unused in unicycle mode",
            "default": 10.0,
            "minimum": 1e-06
          },
          "wheelPidP": {
            "type": "number",
            "description": "Wheel-physics I-P proportional gain on measured wheel speed (N m s/rad); unused in unicycle mode",
            "default": 1.8,
            "minimum": 0
          },
          "commandGain": {
            "type": "number",
            "description": "Wheel-physics allocation calibration multiplying both common and differential wheel commands; unicycle uses unity gain",
            "default": 1.01,
            "minimum": 0
          },
          "angularCommandGain": {
            "type": "number",
            "description": "Additional wheel-physics yaw allocation calibration; unicycle uses unity gain",
            "default": 1.46,
            "minimum": 0
          },
          "commandDelaySeconds": {
            "type": "number",
            "description": "One pure cmd_vel delay in seconds for either plant; unicycle additionally has separate first-order channel time constants; excludes measurement delay",
            "default": 0.005,
            "minimum": 0
          },
          "wheelRadius": {
            "type": "number",
            "description": "Wheel radius in meters",
            "default": 0.08,
            "minimum": 0.001
          },
          "wheelTrack": {
            "type": "number",
            "description": "Mounting-joint separation in meters; not the outward-offset tire contact-center or identified effective skid-steer track",
            "default": 0.416503,
            "minimum": 0.01
          },
          "wheelbase": {
            "type": "number",
            "description": "Wheelbase in meters",
            "default": 0.451,
            "minimum": 0.01
          },
          "dynamicsMode": {
            "type": "string",
            "description": "Spawn-time plant selection. Stop/delete and respawn to change; no per-switch package release. Unicycle is for flat-ground free-motion algorithms, not collision-force or tire-slip validation.",
            "default": "unicycle",
            "enum": [
              "wheel_physics",
              "unicycle"
            ]
          },
          "unicycleLinearTimeConstantSeconds": {
            "type": "number",
            "description": "Unicycle-only forward velocity first-order time constant (seconds), after commandDelaySeconds; never added to wheel physics",
            "default": 0.005,
            "minimum": 1e-06
          },
          "unicycleAngularTimeConstantSeconds": {
            "type": "number",
            "description": "Unicycle-only yaw-rate first-order time constant (seconds), after commandDelaySeconds; never added to wheel physics",
            "default": 0.005,
            "minimum": 1e-06
          },
          "wheelDiagnostics": {
            "type": "boolean",
            "description": "Read-only planar wheel-target/actual/slip diagnostic in wheel_physics mode; no force or controller modifications",
            "default": false
          },
          "targetId": {
            "type": "string",
            "description": "Native service local target identity",
            "default": "core"
          },
          "launchInput": {
            "type": "json",
            "description": "Frozen Robot and actual completed world ServiceRef for native launch",
            "default": {
              "robot": {},
              "simulationServiceRef": {}
            }
          }
        },
        "required": []
      },
      "command": {
        "executable": "/opt/ros/noetic/lib/xgc2_simple_lidar/launch_robot.py",
        "args": [
          "--profile",
          "scout",
          "--namespace",
          "${namespace}",
          "--target-id",
          "${targetId}",
          "/opt/ros/noetic/share/gazebo_sim_scout/launch/spawn_accurate.launch",
          "dynamics_mode:=${dynamicsMode}",
          "unicycle_linear_time_constant_s:=${unicycleLinearTimeConstantSeconds}",
          "unicycle_angular_time_constant_s:=${unicycleAngularTimeConstantSeconds}",
          "wheel_diagnostics:=${wheelDiagnostics}",
          "world_frame:=world",
          "wheel_contact_fdir1:=${wheelContactFdir1}",
          "wheel_contact_mu1:=${wheelContactMu1}",
          "wheel_contact_slip1:=${wheelContactSlip1}",
          "wheel_contact_mu2:=${wheelContactMu2}",
          "wheel_contact_slip2:=${wheelContactSlip2}",
          "wheel_pid_p:=${wheelPidP}",
          "wheel_pid_i:=${wheelPidI}",
          "wheel_velocity_limit:=${wheelVelocityLimit}",
          "wheel_effort_limit:=${wheelEffortLimit}",
          "wheelbase:=${wheelbase}",
          "wheel_track:=${wheelTrack}",
          "wheel_separation:=${wheelTrack}",
          "wheel_radius:=${wheelRadius}",
          "command_gain:=${commandGain}",
          "angular_command_gain:=${angularCommandGain}",
          "command_delay_s:=${commandDelaySeconds}",
          "max_linear_speed:=${maxLinearSpeed}",
          "max_angular_speed:=${maxAngularSpeed}"
        ],
        "env": {
          "GAZEBO_MASTER_URI": "${gazeboMasterUri}",
          "ROS_IP": "${rosIp}",
          "ROS_MASTER_URI": "${rosMasterUri}"
        },
        "stdinParameter": "launchInput"
      },
      "setupFiles": [
        "/opt/ros/noetic/setup.bash"
      ],
      "readiness": {
        "kind": "none"
      },
      "stop": {
        "graceMs": 12000
      },
      "logs": {
        "maxBytes": 1048576,
        "files": 3
      }
    }
  ]
}
